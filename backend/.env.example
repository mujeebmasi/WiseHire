# Your local PostgreSQL. Replace YOUR_PASSWORD with your postgres password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/wisehire?schema=public"

# Used to sign login tokens. Any long random string works.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"

PORT=4000
# Comma-separated if you need to allow more than one address.
FRONTEND_URL="http://localhost:3000"

# Where resumes are stored. Any S3-compatible provider works.
# For Amazon S3, leave S3_ENDPOINT blank.
# For Backblaze B2, use the endpoint shown on your bucket.
S3_BUCKET="your-bucket-name"
S3_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
S3_REGION="us-west-004"
S3_KEY_ID=""
S3_KEY_SECRET=""
