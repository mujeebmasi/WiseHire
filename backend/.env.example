# Your local PostgreSQL. Replace YOUR_PASSWORD with your postgres password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/wisehire?schema=public"

# Used to sign login tokens. Any long random string works.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"

PORT=4000
# Comma-separated if you need to allow more than one address.
FRONTEND_URL="http://localhost:3000"
